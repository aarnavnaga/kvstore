# kind, kubectl and helm in one image, so the Kubernetes end-to-end test needs nothing
# installed on the host but Docker. Runs with the host's Docker socket mounted.
FROM docker:27.3.1-cli
ARG TARGETARCH
ARG KIND_VERSION=v0.24.0
ARG KUBECTL_VERSION=v1.31.0
ARG HELM_VERSION=v3.16.1
RUN apk add --no-cache bash curl \
    && curl -fsSLo /usr/local/bin/kind "https://kind.sigs.k8s.io/dl/${KIND_VERSION}/kind-linux-${TARGETARCH}" \
    && curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
    && curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" | tar -xz -C /tmp \
    && mv "/tmp/linux-${TARGETARCH}/helm" /usr/local/bin/helm \
    && chmod +x /usr/local/bin/kind /usr/local/bin/kubectl /usr/local/bin/helm
WORKDIR /work
